PORT=3000

# Supabase project URL, e.g. https://abcdefgh.supabase.co  (REQUIRED)
# The server fetches Supabase's public signing keys from here to verify the
# access tokens the app sends. Not a secret — it's the same URL the mobile
# app uses. The server refuses to start without it.
SUPABASE_URL=

# Postgres connection. On Supabase: Project Settings > Database >
# Connection string > URI (use the pooled "Transaction" URI for hosted
# deploys). Takes priority over the DB_* vars below when set.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local dev without DATABASE_URL falls back to these.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medtrack
DB_PASSWORD=medtrack
DB_NAME=medtrack

# Browser origins allowed to call the API, comma separated. The mobile app
# does not need this (native clients send no Origin). Leave empty to block
# all browser callers.
# CORS_ORIGINS=https://example.com
