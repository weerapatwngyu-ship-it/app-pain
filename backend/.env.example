PORT=3000

# Local dev: leave DATABASE_URL unset, use these instead.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medtrack
DB_PASSWORD=medtrack
DB_NAME=medtrack

# Hosted deploy (Render/Neon/Supabase/etc): set this instead of the DB_* vars
# above — it takes priority when present. Get it from your DB provider's
# dashboard, looks like:
# postgresql://user:password@host:5432/dbname
# DATABASE_URL=

# REQUIRED. Random string, at least 16 characters — the server refuses to
# start on a missing, short, or placeholder value. Anyone who knows this can
# forge a login token for any account, so generate your own and never commit
# the real one. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Browser origins allowed to call the API, comma separated. The mobile app
# does not need this (native clients send no Origin). Leave empty to block
# all browser callers.
# CORS_ORIGINS=https://example.com
